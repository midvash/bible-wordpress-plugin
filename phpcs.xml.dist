<?xml version="1.0"?>
<ruleset name="Midvash Bible References">
	<description>WordPress Coding Standards + PHP 7.4 compatibility for the Midvash Bible References plugin.</description>

	<file>midvash-bible-references.php</file>
	<file>uninstall.php</file>
	<file>includes</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>
	<exclude-pattern>tests/*</exclude-pattern>
	<exclude-pattern>scripts/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="4"/>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- Filename convention conflicts with the existing class-mvbr-*.php layout only if renamed; keep default. -->
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="midvash-bible-references"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="mvbr"/>
				<element value="MVBR"/>
				<element value="midvash_bible_references"/>
			</property>
		</properties>
	</rule>

	<!-- Declared minimum: WP 5.0, PHP 7.4 -->
	<config name="minimum_wp_version" value="5.0"/>
	<rule ref="PHPCompatibilityWP"/>
	<config name="testVersion" value="7.4-"/>
</ruleset>
